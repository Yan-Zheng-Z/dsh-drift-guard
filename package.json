{
  "name": "dsh-drift-guard",
  "version": "0.4.0",
  "private": true,
  "description": "Deterministic drift guard for DSH: blocks writes outside the workspace and reads of sensitive credential files, reports writes outside the approved PLAN.md phases, and appends leveled reminders driven by three mechanisms (M1 no-new-information, M2 plan stall, M3 unproductive loop) plus handoff-ratio R, with handoff completion detection.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./rules": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/config.js",
    "lib/paths.js",
    "lib/plan.js",
    "lib/persist.js",
    "lib/signals.js",
    "lib/sensitive.js",
    "lib/alerts.js",
    "lib/observation.js",
    "lib/detectors.js",
    "lib/score.js",
    "lib/rules.js",
    "lib/delivery.js",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "drift-guard"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
